# =============================================================================
# CSR compilation for openPCIE -- SystemRDL in, RTL + HAL out
#
# Run FROM THIS FOLDER (4.build/), on Linux or WSL:
#   source set-env.sh              (tcsh: source set-env.csh) -- finds the tools
#   make -f MakefileCSR            regenerate everything
#   make -f MakefileCSR clean      remove all generated files
#
# Single source of truth is  csr_build/csr.rdl. Everything below is derived
# from it and lands in  csr_build/generated-files/ :
#
#   csr_cosim.rdl : filtered RDL, buffer-write commands removed
#   csr.sv        : the CSR RTL for the hardware target
#   csr_pkg.sv    : the hwif_in / hwif_out struct package for that RTL
#   csr.h         : "peakrdl c-header" output, used by both HAL headers
#   csr_hw.h      : C++ HAL for the hardware target (the C firmware uses csr.h)
#   csr_cosim.h   : HAL for the VProc based co-simulation
#   openpcie.md   : the register map as markdown
#   html/         : the register map as a browsable HTML document
#
# Requires (pip install peakrdl peakrdl-regblock peakrdl-cheader \
#                       peakrdl-html peakrdl-markdown systemrdl-compiler)
#
# PEAKRDL and PYTHON must come from the same install, or sysrdl_cosim.py fails
# with "ModuleNotFoundError: No module named 'systemrdl'". set-env.sh sets
# both; run "make -f MakefileCSR tools" to see what was picked up.
# =============================================================================

# Interpreter for sysrdl_cosim.py, and the PeakRDL command line tool
PYTHON   ?= python3
PEAKRDL  ?= peakrdl

RDLCSRTOP = csr
RDLPCIETOP= openpcie
RDLPREFIX = csr
RDLDIR    = csr_build
GENDIR    = $(RDLDIR)/generated-files
RDLSRC    = $(RDLDIR)/$(RDLPREFIX).rdl

COSIMRDL  = $(GENDIR)/$(RDLPREFIX)_cosim.rdl
COSIMHDR  = $(GENDIR)/$(RDLPREFIX)_cosim.h
PKRDLHDR  = $(GENDIR)/$(RDLPREFIX).h
HWHDR     = $(GENDIR)/$(RDLPREFIX)_hw.h
PKRDLHTML = $(GENDIR)/html/
PKRDLMD   = $(GENDIR)/$(RDLPCIETOP).md

# ---- REUSE compliance -------------------------------------------------------
# The tools do not emit SPDX headers, and the repository is REUSE-linted, so
# every generated text file gets stamped right after it is written.
# csr_cosim.rdl needs no stamping -- sed copies csr.rdl verbatim, header and all.
# REUSE-IgnoreStart  (the SPDX tags below are text this make file writes, not its own)
define spdx_c
@printf '%s\n' '// SPDX-FileCopyrightText: 2026 Chili.CHIPS' \
               '//' \
               '// SPDX-License-Identifier: BSD-3-Clause' \
               '' | cat - $(1) > $(1).spdx && mv $(1).spdx $(1)
endef

define spdx_md
@printf '%s\n' '<!--' \
               'SPDX-FileCopyrightText: 2026 Chili.CHIPS' \
               '' \
               'SPDX-License-Identifier: BSD-3-Clause' \
               '-->' \
               '' | cat - $(1) > $(1).spdx && mv $(1).spdx $(1)
endef
# REUSE-IgnoreEnd

all: $(COSIMHDR) $(HWHDR) rtl $(PKRDLHTML) $(PKRDLMD)

$(COSIMHDR): $(COSIMRDL) $(PKRDLHDR)
	@$(PYTHON) sysrdl_cosim.py -c -r $< -o $@
	$(call spdx_c,$@)

$(HWHDR): $(COSIMRDL) $(PKRDLHDR)
	@$(PYTHON) sysrdl_cosim.py -r $< -o $@
	$(call spdx_c,$@)

$(COSIMRDL): $(RDLSRC)
	@sed -e "/buffer_writes/d" -e "/wbuffer_trigger/d" < $^ > $@

$(PKRDLHDR): $(COSIMRDL)
	@$(PEAKRDL) c-header $^ -b ltoh -o $@
	$(call spdx_c,$@)

rtl: $(RDLSRC)
	@$(PEAKRDL) regblock $^ -o $(GENDIR)/ --cpuif passthrough --default-reset arst_n --top $(RDLCSRTOP)
	$(call spdx_c,$(GENDIR)/$(RDLCSRTOP).sv)
	$(call spdx_c,$(GENDIR)/$(RDLCSRTOP)_pkg.sv)

$(PKRDLHTML): $(RDLSRC)
	@$(PEAKRDL) html $^ -o $@ --top $(RDLPCIETOP)

$(PKRDLMD): $(RDLSRC)
	@$(PEAKRDL) markdown $^ -o $@ --top $(RDLPCIETOP)
	$(call spdx_md,$@)

# Report what the generation flow would actually use. Run this first when
# "make -f MakefileCSR" fails -- it says which interpreter was picked up and
# whether the packages are in it.
tools:
	@echo "PYTHON   = $(PYTHON)"
	@echo "  path   : $$(command -v $(PYTHON) 2>/dev/null || echo 'NOT FOUND')"
	@$(PYTHON) -c "import systemrdl; print('  systemrdl-compiler: OK')" 2>/dev/null \
	   || echo "  systemrdl-compiler: MISSING  <-- see the note at the top of this file"
	@echo "PEAKRDL  = $(PEAKRDL)"
	@echo "  path   : $$(command -v $(PEAKRDL) 2>/dev/null || echo 'NOT FOUND')"
	@$(PEAKRDL) --version 2>/dev/null | sed 's/^/  version: /' || true

clean:
	@rm -rf $(COSIMRDL) $(COSIMHDR) $(HWHDR) $(PKRDLHDR) $(GENDIR)/*.sv $(PKRDLHTML) $(PKRDLMD)

.PHONY: all rtl tools clean
