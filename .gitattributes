*.sv    linguist-language=SystemVerilog
*.svh   linguist-language=SystemVerilog
*.v     linguist-language=Verilog

0.doc/** linguist-documentation
*.html  linguist-documentation

# GitHub's language bar counts our own code only: the frozen AMD example
# design, the third-party co-sim models and the PeakRDL output stay out
2.amd-rtl-with-Vivado-build/**       linguist-vendored
5.sim/models/cosim/**                linguist-vendored
5.sim/models/pcievhost/**            linguist-vendored
5.sim/models/rv32/**                 linguist-vendored
4.build/csr_build/generated-files/** linguist-generated

# LF in the working copy too, whatever core.autocrlf says
*.sv      text eol=lf
*.svh     text eol=lf
# scripts, Makefiles and run configs are read on Linux / WSL, where a CR
# breaks bash and ends up in file names (e.g. the rv32 ISS's vusermain.cfg)
*.sh      text eol=lf
*.csh     text eol=lf
*.cfg     text eol=lf
Makefile* text eol=lf
*.v       text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.tcl     text eol=lf
*.xdc     text eol=lf
*.rdl     text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.drawio  text eol=lf
Makefile* text eol=lf
*.bat     text eol=crlf
