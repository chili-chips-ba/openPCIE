#--------
# Firmware build products (4.build/sw_build)
#--------
# Records the VARIANT/CSR/SIM the last build used, so make can tell that the
# configuration changed. Purely local state.
4.build/sw_build/.build-config
4.build/hw_build.openXC7/.build-config
4.build/hw_build.openXC7/.build-config.switched
4.build/hw_build.openXC7/chipdb/

# Intermediates -- rebuilt on every run. Kept on purpose (not ignored):
#   4.build/csr_build/generated-files/  so a build never needs peakrdl
#   4.build/sw_build/firmware.hex       hard dependency of the Vivado tcl
#   build_artifacts*/top.bit            prebuilt bitstreams
4.build/sw_build/firmware.elf
4.build/sw_build/firmware.bin
4.build/hw_build.openXC7/firmware.hex
4.build/hw_build.openXC7/converted/
4.build/hw_build.openXC7/converted.switched/
4.build/hw_build.openXC7/build_artifacts*/*
!4.build/hw_build.openXC7/build_artifacts*/top.bit

