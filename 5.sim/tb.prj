#
# xsim source list for the openpcie2-rc co-simulation test bench.
#
# ORDER MATTERS: packages and interfaces first, then the modules that use them.
#
# The RTL is taken straight out of 2.rtl/0.common.opensource -- no copies,
# no forks. Exactly two files are swapped for co-simulation models:
#
#   src/pcie/phy_top.sv  ->  models/phy_top.PIPE.sv
#         the GT transceiver cannot talk to a PIPE-level VIP, so a behavioural
#         PIPE PHY takes its place and carries the pcievhost endpoint
#
#   (nothing else)
#
# To go back to the old stand-alone stub test bench, use stubs/tb.STUB.prj.

# ---------------------------------------------------------------------
# Co-simulation models
# ---------------------------------------------------------------------
sv work models/cosim/mem_model.sv
sv work models/cosim/f_VProc.v
# VProc dressed up as a picorv32. Only reached when the design is analysed with
# --define SOC_CPU_VPROC (make CPU=vproc / CPU=iss); otherwise it is compiled
# but never instantiated, and xelab prunes it.
sv work models/soc_cpu.VPROC.picorv32.sv
sv work models/pcievhost/verilog/pcieVHost/pcieVHost.v
sv work models/pcievhost/verilog/pcieVHost/pcieVHostPipex1.v
sv work models/pcieVHostPipexN.sv
sv work models/PIPExN__pcieVHost.sv
sv work models/pipe_x4_view.sv

# ---------------------------------------------------------------------
# DUT: packages and interfaces
# ---------------------------------------------------------------------
sv work ../2.rtl/0.common.opensource/src/pcie/link_pkg.sv
sv work ../2.rtl/0.common.opensource/src/pcie/pcie_pkg.sv
sv work ../2.rtl/0.common.opensource/src/pcie/axis_if.sv
sv work ../2.rtl/0.common.opensource/src/pcie/trn_if.sv
sv work ../2.rtl/0.common.opensource/src/pcie/cfg_if.sv
sv work ../2.rtl/0.common.opensource/src/pcie/mem_if.sv
sv work ../2.rtl/0.common.opensource/src/pcie/mim_if.sv
sv work ../2.rtl/0.common.opensource/src/pcie/pipe_if.sv

# ---------------------------------------------------------------------
# DUT: PeakRDL-generated CSR
# ---------------------------------------------------------------------
sv work ../4.build/csr_build/generated-files/csr_pkg.sv
sv work ../4.build/csr_build/generated-files/csr.sv
sv work ../2.rtl/0.common.opensource/src/soc_csr.sv

# ---------------------------------------------------------------------
# DUT: PCIe stack
# ---------------------------------------------------------------------
# phy_top.sv is DELIBERATELY absent -- models/phy_top.PIPE.sv below
# provides that module instead. mac2phy.sv, rx_eios_filter.sv, gtp_wrapper.sv,
# lane_xcvr.sv, chan_retune.sv, phase_align.sv, speed_ctrl.sv
# and init_ctrl.sv only exist inside phy_top,
# so they go with it.
sv work ../2.rtl/0.common.opensource/src/pcie/buffer_bank.sv
sv work ../2.rtl/0.common.opensource/src/pcie/clk_rst_gen.sv
sv work ../2.rtl/0.common.opensource/src/pcie/speed_ctrl.sv
sv work ../2.rtl/0.common.opensource/src/pcie/trn_bridge.sv
sv work ../2.rtl/0.common.opensource/src/pcie/trn_rx.sv
sv work ../2.rtl/0.common.opensource/src/pcie/trn_tx_throttle.sv
sv work ../2.rtl/0.common.opensource/src/pcie/trn_tx.sv
sv work ../2.rtl/0.common.opensource/src/pcie/pcie_core.sv
sv work ../2.rtl/0.common.opensource/src/pcie/pcie_top.sv

# PIPE PHY model, in place of src/pcie/phy_top.sv
sv work models/phy_top.PIPE.sv

# ---------------------------------------------------------------------
# DUT: SOC and top level
# ---------------------------------------------------------------------
sv work ../2.rtl/0.common.opensource/src/picorv32.CHILI.sv
sv work ../2.rtl/0.common.opensource/src/CPU.eduBOS5/edubos5_pkg.sv
sv work ../2.rtl/0.common.opensource/src/CPU.eduBOS5/edubos5_rf.sv
sv work ../2.rtl/0.common.opensource/src/CPU.eduBOS5/edubos5_alu.sv
sv work ../2.rtl/0.common.opensource/src/CPU.eduBOS5/edubos5.sv
sv work ../2.rtl/0.common.opensource/src/riscv_pcie_soc.sv
sv work ../2.rtl/0.common.opensource/src/RC_opensource.sv


# ---------------------------------------------------------------------
# Test bench
# ---------------------------------------------------------------------
sv work models/tlp_dw_if.sv
sv work models/tlp_dw_monitor.sv
sv work models/tlp_wavecrux_view.sv
sv work ../2.rtl/0.common.opensource/src/CPU.eduBOS5/wavecrux/soc_cpu_view.sv
sv work tb.sv
